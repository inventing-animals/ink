<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ink="clr-namespace:Ink.UI.Controls">

    <ControlTheme TargetType="MenuItem" x:Key="Ink.MenuItemStyle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource Ink.Stroke.None}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink.Brush.Content.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Ink.FontFamily.Base}" />
        <Setter Property="FontSize" Value="{DynamicResource Ink.FontSize.L}" />
        <Setter Property="FontWeight" Value="{DynamicResource Ink.FontWeight.Medium}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Ink.CornerRadius.L}" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="MinWidth" Value="240" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ItemContainerTheme" Value="{DynamicResource Ink.MenuItemStyle}" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Spacing="2" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border
                        Name="HoverBackground"
                        Background="Transparent"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Opacity="0">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Duration="0:0:0.15" Property="Opacity" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>

                    <Border
                        Name="Separator"
                        Background="{DynamicResource Ink.Brush.Divider}"
                        Height="1"
                        Margin="18,9"
                        VerticalAlignment="Center"
                        IsVisible="False" />

                    <Grid
                        Name="ContentGrid"
                        ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                        Margin="{TemplateBinding Padding}">
                        <Path
                            Grid.Column="0"
                            Name="CheckMark"
                            Data="M 2 8 L 6 12 L 14 4"
                            IsVisible="False"
                            Stroke="{TemplateBinding Foreground}"
                            StrokeThickness="2"
                            StrokeLineCap="Round"
                            StrokeJoin="Round"
                            Width="14"
                            Height="14"
                            Margin="0,0,8,0"
                            Stretch="None"
                            VerticalAlignment="Center" />

                        <Ellipse
                            Grid.Column="0"
                            Name="RadioMark"
                            IsVisible="False"
                            Fill="{TemplateBinding Foreground}"
                            Width="8"
                            Height="8"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                        <ContentPresenter
                            Grid.Column="1"
                            Name="IconPresenter"
                            Content="{TemplateBinding Icon}"
                            Margin="0,0,8,0"
                            IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                            VerticalAlignment="Center" />

                        <ContentPresenter
                            Grid.Column="2"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center" />

                        <TextBlock
                            Grid.Column="3"
                            Margin="16,0,0,0"
                            Foreground="{DynamicResource Ink.Brush.Content.Secondary}"
                            Text="{TemplateBinding InputGesture}"
                            IsVisible="{TemplateBinding InputGesture, Converter={x:Static ObjectConverters.IsNotNull}}"
                            VerticalAlignment="Center" />

                        <Path
                            Grid.Column="4"
                            Name="SubmenuChevron"
                            Data="M 4 3 L 9 8 L 4 13"
                            Stroke="{DynamicResource Ink.Brush.Content.Secondary}"
                            StrokeThickness="1.6"
                            StrokeLineCap="Round"
                            StrokeJoin="Round"
                            Width="14"
                            Height="14"
                            Margin="4,0,0,0"
                            Stretch="None"
                            VerticalAlignment="Center" />
                    </Grid>

                    <Popup
                        Name="PART_Popup"
                        IsLightDismissEnabled="True"
                        IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                        OverlayDismissEventPassThrough="True">
                        <LayoutTransformControl Name="PART_PopupLayout" RenderTransformOrigin="0%,0%">
                            <Border
                                Background="{DynamicResource Ink.Brush.Surface.Raised}"
                                BorderBrush="{DynamicResource Ink.Brush.Border.Subtle}"
                                BorderThickness="{DynamicResource Ink.Stroke.Thin}"
                                BoxShadow="{DynamicResource Ink.Shadow.Overlay}"
                                ClipToBounds="True"
                                CornerRadius="{DynamicResource Ink.CornerRadius.L}"
                                MinWidth="{TemplateBinding MinWidth}"
                                Padding="8">
                                <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </Border>
                        </LayoutTransformControl>
                    </Popup>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Path#SubmenuChevron">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:empty /template/ Path#SubmenuChevron">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:separator /template/ Grid#ContentGrid">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:separator /template/ Border#Separator">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#HoverBackground">
            <Setter Property="Background" Value="{DynamicResource Ink.Brush.Surface.Overlay.Subtle}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:selected /template/ Border#HoverBackground">
            <Setter Property="Background" Value="{DynamicResource Ink.Brush.Surface.Overlay.Subtle}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:open /template/ Border#HoverBackground">
            <Setter Property="Background" Value="{DynamicResource Ink.Brush.Surface.Overlay.Subtle}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="{DynamicResource Ink.Disabled.Opacity}" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <Style Selector="^:checked /template/ Path#CheckMark">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:radio /template/ Path#CheckMark">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:radio:checked /template/ Ellipse#RadioMark">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^.ink-danger">
            <Setter Property="Foreground" Value="{DynamicResource Ink.Brush.Danger.Text}" />
        </Style>
        <Style Selector="^.ink-danger:pointerover /template/ Border#HoverBackground">
            <Setter Property="Background" Value="{DynamicResource Ink.Brush.Danger.Subtle}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^.ink-danger:selected /template/ Border#HoverBackground">
            <Setter Property="Background" Value="{DynamicResource Ink.Brush.Danger.Subtle}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^.ink-danger:open /template/ Border#HoverBackground">
            <Setter Property="Background" Value="{DynamicResource Ink.Brush.Danger.Subtle}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
    </ControlTheme>

    <ControlTheme TargetType="MenuItem" x:Key="Ink.MenuTopLevelItemStyle" BasedOn="{StaticResource Ink.MenuItemStyle}">
        <Setter Property="Foreground" Value="{DynamicResource Ink.Brush.Accent.Text}" />
        <Setter Property="FontSize" Value="{DynamicResource Ink.FontSize.M}" />
        <Setter Property="FontWeight" Value="{DynamicResource Ink.FontWeight.SemiBold}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Ink.CornerRadius.Pill}" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border
                        Name="HoverBackground"
                        Background="{DynamicResource Ink.Brush.Surface.Overlay.Stronger}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Opacity="1">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Duration="0:0:0.15" Property="Opacity" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>

                    <ContentPresenter
                        Content="{TemplateBinding Header}"
                        ContentTemplate="{TemplateBinding HeaderTemplate}"
                        Margin="{TemplateBinding Padding}"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Center" />

                    <Popup
                        Name="PART_Popup"
                        IsLightDismissEnabled="True"
                        IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                        OverlayDismissEventPassThrough="True"
                        VerticalOffset="10">
                        <LayoutTransformControl Name="PART_PopupLayout" RenderTransformOrigin="50%,0%">
                            <Border
                                Background="{DynamicResource Ink.Brush.Surface.Raised}"
                                BorderBrush="{DynamicResource Ink.Brush.Border.Subtle}"
                                BorderThickness="{DynamicResource Ink.Stroke.Thin}"
                                BoxShadow="{DynamicResource Ink.Shadow.Overlay}"
                                ClipToBounds="True"
                                CornerRadius="{DynamicResource Ink.CornerRadius.L}"
                                MinWidth="268"
                                Padding="8">
                                <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </Border>
                        </LayoutTransformControl>
                    </Popup>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Ink.Brush.Accent.Text}" />
        </Style>
        <Style Selector="^:open /template/ Border#HoverBackground">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:selected /template/ Border#HoverBackground">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:open /template/ LayoutTransformControl#PART_PopupLayout">
            <Style.Animations>
                <Animation Duration="0:0:0.22" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.92" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.92" />
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </ControlTheme>

    <ControlTheme BasedOn="{StaticResource Ink.MenuItemStyle}" TargetType="MenuItem" x:Key="{x:Type MenuItem}" />
    <ControlTheme BasedOn="{StaticResource Ink.MenuItemStyle}" TargetType="ink:MenuItem" x:Key="{x:Type ink:MenuItem}" />

</ResourceDictionary>
